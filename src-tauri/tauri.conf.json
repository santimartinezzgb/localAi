{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "localAi",
  "version": "1.0.0",
  "identifier": "io.github.localai",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "localAi // AI Desktop",
        "width": 840,
        "height": 640,
        "minWidth": 620,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}